<svg xmlns="http://www.w3.org/2000/svg" width="{{ config.width }}" height="{{ config.height }}" viewBox="0 0 1080 1350" role="img" aria-labelledby="title description">
  <title id="title">{{ post.prompt }}</title>
  <desc id="description">Ask Every Day. A question to sit with.</desc>
  <rect width="1080" height="1350" fill="#F4F0E8"/>
  <g fill="#343B35" font-family="Arial, Helvetica, sans-serif">
    <text id="classic-brand" x="540" y="147" text-anchor="middle" font-size="23" letter-spacing="1.5"><tspan fill="#8D957F">@</tspan><tspan fill="#343B35">ask.every.day</tspan></text>
    <path d="M512 190 H568" stroke="#8D957F" stroke-width="2"/>
  </g>
  <g font-family="Georgia, 'Times New Roman', serif" font-size="76" fill="#292E29" letter-spacing="-2">
{% for prefix, highlight, suffix, baseline in lines %}
    <text x="112" y="{{ baseline }}"{% if automatic %} xml:space="preserve"{% endif %}>{{ prefix }}<tspan fill="#717A60">{{ highlight }}</tspan>{{ suffix }}</text>
{% endfor %}
  </g>
  <g font-family="Arial, Helvetica, sans-serif" fill="#62695F">
    <text x="112" y="1138" font-size="20" letter-spacing="1.5">A QUESTION TO SIT WITH.</text>
  </g>
</svg>
